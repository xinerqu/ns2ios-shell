diff --git a/dm/host/loader.c b/dm/host/loader.c
--- a/dm/host/loader.c
+++ b/dm/host/loader.c
@@ -724,7 +724,80 @@
 #include "front.h"
 static const struct mach_header_64 *g_game_image = &_mh_execute_header;
 void dm_set_game_image_header(const void *mh) { g_game_image = mh; }
+#ifdef DM_SHELL
+// Shell (dm/ios/tools/shell_build.sh): the app carries no game content at all, so the module images are not in this executable but in
+// Frameworks/Guest.framework/Guest -- a dynamic library that holds only segments, written by dm/tools/guest_dylib.py from the user's own
+// game files. The section names are the same as in the embedded approach (gen_embed.py), so only the image header to read them from changes.
+//
+// An app that holds several games has one framework per game (DmGame<title ID>.framework, guest_dylib.py --name) and DM_GAME_IMAGE names
+// the one this run starts: dm/ios/Sources/main.m sets it from the game the launcher picked. Unset (the one-game package, and every
+// package made before the shell had a library) the path below is the Guest framework, exactly as it was.
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+static const struct mach_header_64 *shell_image_quiet(const char **why) {
+    static const struct mach_header_64 *mh; static const char *cached;
+    if (mh) return mh;
+    if (cached) { if (why) *why = cached; return NULL; }
+    char exe[4096]; uint32_t n = sizeof exe;
+    const char *given = getenv("DM_GAME_IMAGE");
+    if (given && *given) {
+        if (strlen(given) + 1 > sizeof exe) { cached = "DM_GAME_IMAGE is too long"; if (why) *why = cached; return NULL; }
+        strcpy(exe, given);
+        if (access(exe, R_OK)) { cached = "the game framework DM_GAME_IMAGE names is not readable"; if (why) *why = cached; return NULL; }
+    } else {
+        if (_NSGetExecutablePath(exe, &n)) { cached = "cannot get the executable path"; if (why) *why = cached; return NULL; }
+        char *sl = strrchr(exe, '/');
+        if (!sl || (size_t)(sl - exe) + 40 > sizeof exe) { cached = "unexpected executable path"; if (why) *why = cached; return NULL; }
+        strcpy(sl, "/Frameworks/Guest.framework/Guest");
+        if (access(exe, R_OK)) { cached = "Frameworks/Guest.framework/Guest is not in this package"; if (why) *why = cached; return NULL; }
+    }
+    if (!dlopen(exe, RTLD_NOW)) { cached = "dlopen of the game framework failed"; fprintf(stderr, "boot: dlopen %s: %s\n", exe, dlerror()); if (why) *why = cached; return NULL; }
+    // The image is found by the tail of its path, "<name>.framework/<name>", not by the whole path: dyld reports the resolved path, which
+    // can differ from the one dlopen was given (symbolic links, /private/var for /var).
+    const char *last = strrchr(exe, '/'), *tail = last ? last : exe;
+    if (last) for (const char *p = last - 1; p > exe; p--) if (*p == '/') { tail = p; break; }   // "<name>.framework/<name>"
+    for (uint32_t i = 0; i < _dyld_image_count(); i++) { const char *nm = _dyld_get_image_name(i); if (nm && strstr(nm, tail)) mh = (const struct mach_header_64 *)_dyld_get_image_header(i); }
+    if (!mh) { cached = "the game framework is loaded but its image header was not found"; if (why) *why = cached; return NULL; }
+    fprintf(stderr, "boot: module images come from the game framework %s\n", exe); return mh;
+}
+static const struct mach_header_64 *shell_image(void) {
+    const char *why = NULL; const struct mach_header_64 *mh = shell_image_quiet(&why);
+    if (!mh) die("this package has no game program yet: %s. Pack your own game files into it with scripts/nxn_pack.py first.", why);
+    return mh;
+}
+// Module names present in the Guest library, read back from its __dm<name>x0 sections, so one shell serves any game without a
+// module list compiled in. main.c takes module names from argv; dm/ios/Sources/main.m appends these before calling dm_main.
+int dm_shell_modules(const char **out, int max) {
+    static char store[16][17]; static const char *ptrs[16]; static int cached = -1;
+    if (cached >= 0) { int k = cached < max ? cached : max; for (int i = 0; i < k; i++) out[i] = ptrs[i]; return k; }
+    const char *why = NULL; const struct mach_header_64 *mh = shell_image_quiet(&why);
+    if (!mh) { fprintf(stderr, "boot: no module list from the Guest library (%s); falling back to the compiled-in one\n", why); cached = 0; return 0; }
+    int n = 0; const uint8_t *p = (const uint8_t *)(mh + 1);
+    for (uint32_t i = 0; i < mh->ncmds && n < 16; i++) {
+        const struct load_command *lc = (const struct load_command *)p;
+        if (lc->cmdsize < sizeof(struct load_command)) break;
+        if (lc->cmd == LC_SEGMENT_64 && lc->cmdsize >= sizeof(struct segment_command_64)) {
+            const struct segment_command_64 *sc = (const struct segment_command_64 *)p;
+            const struct section_64 *s = (const struct section_64 *)(sc + 1);
+            for (uint32_t k = 0; k < sc->nsects && n < 16; k++, s++) {
+                size_t l = strnlen(s->sectname, 16);
+                if (l < 7 || strncmp(s->sectname, "__dm", 4) || l + sizeof(struct segment_command_64) > lc->cmdsize) continue;
+                if (s->sectname[l - 2] != 'x' || s->sectname[l - 1] != '0') continue;
+                size_t nl = l - 6; if (nl > 16) continue;
+                int dup = 0; for (int j = 0; j < n; j++) if (!strncmp(ptrs[j], s->sectname + 4, nl) && !ptrs[j][nl]) dup = 1;
+                if (dup) continue;
+                memcpy(store[n], s->sectname + 4, nl); store[n][nl] = 0; ptrs[n] = store[n]; n++;
+            }
+        }
+        p += lc->cmdsize;
+    }
+    cached = n; int k = n < max ? n : max; for (int i = 0; i < k; i++) out[i] = ptrs[i];
+    return k;
+}
+#define IMAGE_MH (g_game_image != &_mh_execute_header ? g_game_image : shell_image())
+#else
 #define IMAGE_MH g_game_image
+#endif
 // The NRO modules (loader.c "NRO modules") are packed instead of getting sections of their own: a Mach-O file has at most 255 sections, and Super Smash Bros. Ultimate's 98 NROs would
 // take 294. gen_embed.py puts their pieces one after another, each 16K aligned, in __TEXT,__dm_nro_x0 / __DM_NRO_W,__img / __TEXT,__dm_nro_x1, and __DATA,__dm_nro_tab lists them:
 // 32 bytes of name, then the offset and length of its x0, W and x1 pieces in their sections (u64 each). A module name never holds an underscore, so these names meet no module's
