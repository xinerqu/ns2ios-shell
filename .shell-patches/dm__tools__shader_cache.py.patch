+
+
+def _replace(src, dst, tries=40):   # os.replace that survives Windows: a rename onto a file another process has open
+    """A scanner (Defender) reading the .metallib just written is the usual holder, and it lets go within milliseconds, so
+    retry; if the destination itself stays locked, drop it first (every caller overwrites it anyway). POSIX always succeeds."""
+    for i in range(tries):
+        try: os.replace(src, dst); return
+        except PermissionError:
+            if i == tries - 1: raise
+            try: os.unlink(dst)
+            except OSError: pass
+            time.sleep(0.05)
