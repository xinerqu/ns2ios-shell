+static id<MTLRenderPipelineState> pso_learn(NvShader *fs, const pso_key *k, MTLRenderPipelineDescriptor *d, NSError **e) {
+    if (!dm_shader_learn_enabled() || !fs || fs->stage != 1 || k->fsfn || !g_msl_dir) return nil;
